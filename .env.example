# ==========================================
# Hotel Manager Environment Configuration
# ==========================================

# Cryptographic Secret Key for PBKDF2 Session Access Tokens (min 32 characters)
SECRET_KEY=capstone-development-secret-key-at-least-32-chars-long

# Primary Database Connection URL (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://capstone:capstone@localhost:5432/capstone

# Resend Transactional Email SDK API Key (Optional: system simulates email if omitted)
# RESEND_API_KEY=re_your_api_key_here
