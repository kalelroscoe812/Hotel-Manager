{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "npm: dev"
    },
    {
      "name": "Frontend: Debug in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "npm: dev"
    },
    {
      "name": "Backend: Debug FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "hotel_manager.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "DATABASE_URL": "sqlite:///./hotel_manager.db"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Backend: Run Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: FastAPI + Frontend",
      "configurations": [
        "Backend: Debug FastAPI",
        "Frontend: Debug in Chrome"
      ]
    }
  ]
}
